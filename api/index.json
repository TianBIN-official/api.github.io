{
  "siteName": "天彬TianBIN | 框架设定",
  "homeId": "api",
  "apiBase": "https://api.tianbin.org/api/",
  "security": {
    "watermarkText": "起点小说《天彬》",
    "devtoolsRedirect": "http://www.tianbin.net"
  },
  "behavior": {
    "requestTimeout": 1000,
    "concurrencyLimit": 3
  },
  "theme": {
    "default": "white",
    "version": "2.0"
  },
  "opSearch": {
    "enabled": true,
    "numericOnly": true,
    "exactMatch": true,
    "returnPageOnEmpty": true,
    "cardOnFound": true,
    "notFoundText": "该信息未登记!<br>请前往www.TianBIN.org登记!!!"
  },
  "bottomNav": [
    { "id": "api",   "name": "框架设定", "icon": "📜" },
    { "id": "plays",  "name": "官方公告",     "icon": "📢" },
    { "id": "world", "name": "世界观",     "icon": "☭" },
    { "id": "you",   "name": "纶音",     "icon": "🪶", "badge": true },
    { "id": "yo",    "name": "册籍",     "icon": "📖", "badge": true }
  ],
  "sections": {
    "api": {
      "api": "api.json",
      "perPage": 10,
      "searchable": true,
      "searchFields": ["title", "content", "author"],
      "searchMode": "weighted",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "plays": {
      "api": "plays.json",
      "perPage": 5,
      "searchable": true,
      "searchFields": ["title", "content"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "world": {
      "api": "world.json",
      "perPage": 5,
      "searchable": false,
      "searchFields": ["title"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "you": {
      "api": "you.json",
      "perPage": 5,
      "searchable": true,
      "searchFields": ["title", "content"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "yo": {
      "api": "yo.json",
      "perPage": 5,
      "searchable": true,
      "searchFields": ["title", "content", "author"],
      "searchMode": "weighted",
      "sortBy": "date",
      "sortOrder": "desc",
      "opEnabled": true
    }
  }
}