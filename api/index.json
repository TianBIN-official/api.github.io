{
  "siteName": "天彬TianBIN | 框架设定",
  "homeId": "api",
  "apiBase": "https://api.tianbin.org/api/",
  "registerUrl": "https://www.TianBIN.org",
  "favicon": "https://wentianwan.com/favicon.ico",
  "version": "2.1.0",
  "buildTime": "2026-10-02",
  "security": {
    "watermarkText": "起点小说《天彬》",
    "devtoolsRedirect": "http://www.tianbin.net",
    "blockContextMenu": true,
    "blockF12": true,
    "blockCtrlU": true,
    "blockCtrlS": true,
    "blockCopy": true,
    "blockPrint": true,
    "blockDrag": true,
    "blockIframe": true,
    "antiDebugInterval": 800,
    "devtoolsCheckInterval": 500,
    "timeDriftThreshold": 5000
  },
  "behavior": {
    "requestTimeout": 5000,
    "concurrencyLimit": 6,
    "retry": 3,
    "maxSearchHistory": 10,
    "failResetOnSuccess": true
  },
  "theme": {
    "default": "white",
    "version": "2.1"
  },
  "announcement": {
    "enabled": true,
    "source": "https://api.tianbin.org/index.json",
    "requireAgree": true,
    "lockScroll": true,
    "countdown": 6,
    "showImages": true,
    "showHtml": true
  },
  "search": {
    "highlight": true,
    "historyEnabled": true,
    "maxHistory": 10,
    "historyStorageKey": "tianbin_search_history",
    "preventBubble": true,
    "clearClosesPanel": true
  },
  "music": {
    "enabled": true,
    "volume": 0.7,
    "loop": true,
    "autoplay": false,
    "defaultIndex": 0,
    "playerType": "netease-outchain",
    "outchainBase": "http://music.163.com/outchain/player",
    "outchainParams": "type=0&auto=0&height=430",
    "list": [
      {
        "name": "烂泥",
        "artist": "草东没有派对",
        "type": 0,
        "id": "22768905"
      },
      {
        "name": "山海",
        "artist": "草东没有派对",
        "type": 0,
        "id": "436514312"
      }
    ]
  },
  "background": {
    "type": "image",
    "src": "https://tianbin.net/bg/main.jpg"
  },
  "router": {
    "enabled": true,
    "prefix": "#",
    "pattern": ":col/:id",
    "cardOnFound": true,
    "notFoundText": "该信息未登记!<br>请前往www.TianBIN.org登记!!!"
  },
  "opSearch": {
    "enabled": true,
    "numericOnly": true,
    "exactMatch": true,
    "returnPageOnEmpty": true,
    "cardOnFound": true,
    "highlight": true,
    "notFoundText": "该信息未登记!<br>请前往www.TianBIN.org登记!!!",
    "autoOpenDelay": 0,
    "preventTypingInterrupt": true
  },
  "errorMessages": {
    "loadFailed": "拉取加载数据中...",
    "emptyContent": "暂无内容",
    "notFound": "该信息未登记!<br>请前往www.TianBIN.org登记!!!",
    "copySuccess": "链接已复制",
    "retryCount": "重试中 ({count}/3)"
  },
  "bottomNav": [
    { "id": "play", "name": "框架设定", "icon": "📜" },
    { "id": "wan", "name": "『纶音』", "icon": "📢" },
    { "id": "api", "name": "༺探险之旅༻", "icon": "🪶" },
    { "id": "world", "name": "世界观", "icon": "☭", "badge": true },
    { "id": "yo", "name": "册籍", "icon": "📖", "badge": true }
  ],
  "sections": {
    "play": {
      "name": "框架设定",
      "api": "play.json",
      "perPage": 5,
      "searchable": true,
      "opEnabled": false,
      "searchFields": ["title", "content", "author"],
      "searchMode": "weighted",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "wan": {
      "name": "『纶音』",
      "api": "wan.json",
      "perPage": 5,
      "searchable": true,
      "opEnabled": false,
      "searchFields": ["title", "content"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "api": {
      "name": "༺探险之旅༻",
      "api": "api.json",
      "perPage": 5,
      "searchable": false,
      "opEnabled": false,
      "searchFields": ["title"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "world": {
      "name": "世界观",
      "api": "world.json",
      "perPage": 5,
      "searchable": true,
      "opEnabled": false,
      "searchFields": ["title", "content"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "yo": {
      "name": "册籍",
      "api": "yo.json",
      "perPage": 5,
      "searchable": true,
      "opEnabled": true,
      "searchFields": ["title", "content", "author"],
      "searchMode": "weighted",
      "sortBy": "id",
      "sortOrder": "desc"
    }
  }
}