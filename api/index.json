{
  "siteName": "天彬TianBIN | 框架设定",
  "homeId": "api",
  "apiBase": "https://api.tianbin.org/api/",
  "security": {
    "watermark": true,
    "watermarkText": "起点小说《天彬》",
    "imgWatermark": true,
    "devtoolsRedirect": "http://www.tianbin.net"
  },
  "behavior": {
    "requestTimeout": 1000,
    "concurrencyLimit": 3,
    "retryBackoff": [500, 1000, 2000],
    "pagerPosition": "bottom"
  },
  "theme": {
    "default": "white"
  },
  "bottomNav": [
    { "id": "api", "name": "框架设定", "icon": "🏠" },
    { "id": "you1", "name": "公告", "icon": "📢" },
    { "id": "about", "name": "关于", "icon": "ℹ️" },
    { "id": "you", "name": "纶音", "icon": "📋", "badge": true },
    { "id": "yo", "name": "册籍", "icon": "📚", "badge": true }
  ],
  "sections": {
    "api": {
      "api": "api.json",
      "perPage": 10,
      "searchable": true,
      "searchFields": ["title", "content", "author"],
      "searchMode": "weighted",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "you1": {
      "api": "notice.json",
      "perPage": 10,
      "searchable": true,
      "searchFields": ["title", "content"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "about": {
      "api": "about.json",
      "perPage": 10,
      "searchable": false,
      "searchFields": ["title"],
      "searchMode": "simple",
      "sortBy": "",
      "sortOrder": "desc"
    },
    "you": {
      "api": "you.json",
      "perPage": 10,
      "searchable": true,
      "searchFields": ["title", "content"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "yo": {
      "api": "yo.json",
      "perPage": 5,
      "searchable": true,
      "searchFields": ["title", "content", "author"],
      "searchMode": "weighted",
      "sortBy": "date",
      "sortOrder": "desc"
    }
  }
