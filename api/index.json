{
  "siteName": "天彬TianBIN | 框架设定",
  "homeId": "home",
  "apiBase": "https://api.tianbin.org/api/",
  "security": {
    "watermark": true,
    "watermarkText": "天彬TianBIN",
    "devtoolsRedirect": "http://www.tianbin.net"
  },
  "behavior": {
    "requestTimeout": 1000,
    "concurrencyLimit": 3,
    "retryBackoff": [500, 1000, 2000]
  },
  "theme": {
    "default": "white"
  },
  "bottomNav": [
    {
      "id": "home",
      "name": "框架设定",
      "icon": "🏠"
    },
    {
      "id": "you",
      "name": "纶音",
      "icon": "📢"
    },
    {
      "id": "yo",
      "name": "册籍",
      "icon": "📚",
      "badge": true
    },
    {
      "id": "notice",
      "name": "公告",
      "icon": "📋",
      "badge": true
    },
    {
      "id": "about",
      "name": "关于",
      "icon": "ℹ️"
    }
  ],
  "sections": {
    "home": {
      "api": "home.json",
      "perPage": 5,
      "searchable": true,
      "searchFields": ["title", "content", "author"],
      "searchMode": "weighted",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "you": {
      "api": "you.json",
      "perPage": 5,
      "searchable": true,
      "searchFields": ["title", "content"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "yo": {
      "api": "yo.json",
      "perPage": 5,
      "searchable": true,
      "searchFields": ["title", "content", "author"],
      "searchMode": "weighted",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "notice": {
      "api": "notice.json",
      "perPage": 5,
      "searchable": true,
      "searchFields": ["title", "content"],
      "searchMode": "simple",
      "sortBy": "date",
      "sortOrder": "desc"
    },
    "about": {
      "api": "about.json",
      "perPage": 5,
      "searchable": false,
      "searchFields": ["title"],
      "searchMode": "simple",
      "sortBy": "",
      "sortOrder": "desc"
    }
  }
}